# --- 1. SECRETS & LOCAL CONFIGS ---
# Ignore all .env files EVERYWHERE.
.env
**/.env
**/.env.local
**/.env.*.local

# ...BUT NEVER ignore the example file.
!**/.env.example

# --- 2. DEPENDENCY CACHES & BUILD ARTIFACTS ---
# Ignore all dependency caches.
# These must be installed in CI or containers, not stored in Git.
**/node_modules/
/packages/engine/venv/
/packages/engine/.venv/
/.venv/

# Ignore all build artifacts and caches.
**/.next/
/out/
/build/
/dist/
/.turbo/
**/__pycache__/
*.pyc
*.pyo

# --- 2.5. TEST ARTIFACTS (NEVER COMMIT) ---
# Test coverage and reports are generated, not stored.
**/coverage/
**/test-results/
**/playwright-report/
**/.pytest_cache/
.coverage
htmlcov/
*.lcov

# --- 3. LOG FILES & REPORTS ---
# Never commit logs.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 4. IDE / EDITOR SETTINGS ---
# Developer-specific settings do not belong in the repository.
.vscode/
.idea/
.fleet/
*.code-workspace

# --- 5. OS-SPECIFIC JUNK (macOS / Windows) ---
# Never commit system-specific metadata files.
.DS_Store
Thumbs.db

# --- 6. TRANSIENT REPORTS & ARCHIVES ---
# Lighthouse/perf audits and ad-hoc zips do not belong in history.
*.report.html
localhost_*.html
*.zip
# TypeScript incremental build state
*.tsbuildinfo
proofs/results.json
proofs/plants.json
proofs/plant-*.json

# A codespace's own stack secrets (.devcontainer/stack_env.py)
.devcontainer/.stack.env
