// Oxy in GitHub Codespaces (or any devcontainer host): the whole stack with the
// recording fake provider from proofs/ in place of a model provider, so nothing
// needs a key. start.sh brings it up on every start and makes a fresh demo
// organization, project, API key and agent session; nothing is stored in the
// repository. The dashboard, auth and the engine share one port (3080) through
// a small proxy, because Codespaces forwards each port on its own private
// origin and a browser page cannot call another one.
//
// Images and features are pinned by digest. The stack's own images are pinned in
// docker-compose.yml and checked by scripts/check-freshness.py.
{
  "name": "Oxy demo",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04@sha256:d94c97dd9cacf183d0a6fd12a8e87b526e9e928307674ae9c94139139c0c6eae",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2.17.0@sha256:25b9f05705ffba7dbe503230ac76081419306f8c8bc88e0ce78c4ecd99a0c78c": {}
  },
  // Sixteen containers and two image builds (engine and dashboard); what they
  // use is measured in .devcontainer/README.md. 4 cores is the smallest
  // Codespaces machine that builds them in minutes (it comes with 16 GB).
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [3080, 8025, 8000],
  "portsAttributes": {
    "3080": { "label": "Oxy dashboard (engine under /engine)", "onAutoForward": "openBrowser" },
    "8025": { "label": "Mailpit: the sign-in links", "onAutoForward": "notify" },
    "8000": { "label": "Gateway API", "onAutoForward": "silent" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "onCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq --no-install-recommends python3 >/dev/null",
  "postStartCommand": "bash .devcontainer/start.sh",
  "waitFor": "postStartCommand"
}
